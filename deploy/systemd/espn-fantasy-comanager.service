[Unit]
Description=ESPN Fantasy CoManager MCP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/espn-fantasy/fantasy-comanager/fantasy-engine/mcp-server
# MCP_HTTP_PORT and MCP_AUTH_TOKEN live here, outside the repo (chmod 600)
EnvironmentFile=/etc/fantasy-mcp/espn-fantasy-comanager.env
ExecStart=/usr/bin/node /opt/espn-fantasy/fantasy-comanager/fantasy-engine/mcp-server/dist/index-new.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
