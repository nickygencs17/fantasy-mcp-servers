[Unit]
Description=NFL Injury/News MCP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/nfl-injury-news-mcp
# MCP_HTTP_PORT and MCP_AUTH_TOKEN live here, outside the repo (chmod 600)
EnvironmentFile=/etc/fantasy-mcp/nfl-injury-news.env
ExecStart=/usr/bin/node /opt/nfl-injury-news-mcp/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
